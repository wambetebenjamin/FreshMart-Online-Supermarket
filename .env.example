# ------------------------------------------------------------------
# FreshMart — environment variables
# Copy to .env.local (dev) or configure in Vercel project settings.
# Everything below is OPTIONAL: each integration degrades gracefully.
# ------------------------------------------------------------------

# Public site URL (used for OG tags, sitemap, JSON-LD, M-Pesa callback)
NEXT_PUBLIC_SITE_URL="https://freshmart.co.ke"

# --- Vercel KV (orders, subscriptions, newsletter, FreshPoints) ---
# Create a KV store in your Vercel project and paste its .env values here.
# Without these, an in-memory store is used (fine for local dev).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- WhatsApp Cloud API (order notifications & confirmations) ---
# Without these, customers still get the prefilled wa.me confirmation link.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- M-Pesa Daraja (STK push on checkout) ---
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_ENV="sandbox"

# --- SMTP email confirmations (Nodemailer) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ORDER_EMAIL_FROM="FreshMart <orders@freshmart.co.ke>"

# --- Optional: OpenWeatherMap (hero weather line) ---
OPENWEATHER_API_KEY=""
